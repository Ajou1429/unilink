# Supabase (Next.js 빌드에 포함되는 공개 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_COACHING_ENABLED=false # GPT 연결 확인 후 true로 변경하는 공개 기능 플래그
NEXT_PUBLIC_SERVICE_AGENT_ENABLED=false # service-agent 서버 배포/검증 후 true, 기존 채팅 기록 경로 유지 가능

# 아래 값들은 .env.local이 아니라 Supabase Edge Function 시크릿으로 등록합니다.
# supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=... 등
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<project-ref>.supabase.co/functions/v1/google-auth/callback
# GOOGLE_DRIVE_WEBHOOK_TOKEN=       # openssl rand -hex 32
# DRIVE_TOKEN_ENC_KEY=              # openssl rand -base64 32 (AES-256-GCM 키, refresh_token 암호화용)
# CRON_SECRET=                      # openssl rand -hex 32 (pg_cron -> drive-renew-channels 검증용)
# FRONTEND_URL=https://<domain>/unilink
# OPENAI_API_KEY=                # OpenAI 프로젝트 API 키 (Edge Function 시크릿 전용)
# COACHING_MODEL=gpt-4.1-mini   # Legacy fallback for other AI workloads
# COACHING_SYNTHESIS_MODEL=gpt-6.1-sol # Optional override of server DB synthesis_model
# NOTE_ANALYSIS_MODEL=gpt-5.4-mini # Optional override of server DB analysis_model
# CHAT_ASSISTANT_MODEL=gpt-6.1-terra # Frontend chat protocol; independent of the legacy recorder model
# COACHING_HARNESS_ENABLED=false # 키와 호출 테스트가 준비되면 true
# SERVICE_AGENT_ENABLED=false # Supabase 서버 통합 비서 활성화 (웹 플래그와 별개)
# SERVICE_ROUTER_MODEL=gpt-6.1-terra
# SERVICE_ASSISTANT_MODEL=gpt-6.1-terra
